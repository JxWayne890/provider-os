# ProviderOS Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google API (read-only Sheets access - only needed during migration)
VITE_GOOGLE_API_KEY=

# Relay Server Auth
VITE_RELAY_AUTH_TOKEN=your-relay-auth-token
RELAY_AUTH_TOKEN=your-relay-auth-token

# Stripe (server-side only)
STRIPE_API_KEY=

# Resend (server-side only)
RESEND_API_KEY=

# ============================================
# Outreach System (Cold Email)
# ============================================

# Resend sending identity
RESEND_FROM_EMAIL=john@go.theprovidersystem.com
RESEND_FROM_NAME=John W Johnson

# Tracking base URL (local dev = http://localhost:3001, prod = https://go.theprovidersystem.com)
TRACKING_BASE_URL=http://localhost:3001

# Resend webhook signing secret (from Resend dashboard > Webhooks)
RESEND_WEBHOOK_SECRET=

# Google Calendar ID for booking availability
GOOGLE_CALENDAR_ID=primary
